# Copy to .env (never commit .env). docker compose reads it automatically.
POSTGRES_PASSWORD=change-me
GRAFANA_PASSWORD=change-me-too

# 1 = the note endpoint returns recorded v4 notes (labelled DEMO), no GPU needed. Leave empty for the real model.
NOTE_DEMO_MODE=

# ---- AWS deployment only (docker-compose.aws.yml; see docs/AWS_DEPLOY.md) ----
# A domain that points at the server. Free option: <elastic-ip-with-dashes>.sslip.io  e.g. 3-91-12-45.sslip.io
SITE_ADDRESS=
BASIC_AUTH_USER=nurse
# bcrypt hash of the login password. Create it on the server with:
#   docker run --rm caddy caddy hash-password --plaintext 'YourPassword'
# Keep the SINGLE QUOTES: the hash contains $ characters that compose would otherwise try to expand.
BASIC_AUTH_HASH='paste-the-hash-here'
